# Backend API base URL (no trailing slash)
# In development this is proxied by Vite to VITE_PROXY_TARGET (e.g. https://api.schemaweaver.dev)
# In production (Cloudflare Pages) set this to your deployed backend URL:
# e.g. https://api.schemaweaver.dev
VITE_PROXY_TARGET=https://api.schemaweaver.dev
VITE_API_BASE_URL=
